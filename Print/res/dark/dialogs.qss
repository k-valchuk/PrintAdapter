QDialog {
    background-color: #2d2d31;
}

QFrame#titleBar {
    background-color: #2b2d32;
}

QLabel[class="title"] {
    font: normal normal normal 18px Roboto;
    color: #6F8CB7;
}

QPushButton#closeButton {
    background: transparent;
    qproperty-icon: url(:/icons/modal-close-icon.svg);
    qproperty-iconSize: 16px 16px
}

QPushButton#closeButton:hover {
    background: rgba(100, 100, 100, 50);
    margin: -10px;
}

QPushButton#cancelButton {
    border: 1px solid #494949;
    border-radius: 2px;
    font: normal normal normal 15px Roboto;
    color: #6F8CB7;
    background-color: transparent;
    margin: 0;
    padding: 0;
    height: 30px;
    width: 93px;
}

QPushButton#cancelButton:pressed {
    border-color:rgba(57,108,145,205);
    background: rgba(57,108,145,50);
    color: rgba(95,142,176,205);
}

QPushButton#cancelButton:hover:!pressed {
    background: rgba(95,142,176, 20);
    color: #90B6D1;
}

QPushButton#applyButton {
    font: normal normal normal 15px Roboto;
    background: #6F8CB7;
    color: #FFFFFF;
    border-radius: 2px;
    margin: 0;
    padding: 0;
    height: 30px;
    width: 114px;
}

QPushButton#applyButton:hover:!pressed
{
	background-color: rgb(85, 125, 180);
}
QPushButton#applyButton:pressed
{
	background-color: rgb(62, 95, 142);
}

QPushButton#toogleButton {
    border: 1px solid #323236;
    color: #c2c2c2;
    border-radius: 4px;
    max-width: 125px;
    max-height: 26px;
    font: normal normal normal 16px Roboto;
    background-color: #323236;
}

QWidget#togglePlaceholder {
    border: 1px solid #323236;
    border-radius: 4px;
    max-height: 30px;
    background-color: #323236;
}

QGroupBox#emptyGroupBox {
    border: none;
    margin: 0;
    padding: 0;
}

QWidget#EmptyStyle {
    margin: 0;
    padding: 0;
}

QGroupBox#addGroupBox {
    background-color: #3D3D41;
    border-radius: 2px 2px 0px 0px;
    height: 28px;
    margin: 0px;
    padding: 0px;
}

QLabel#baseLabel {
    font: normal normal normal 15px Roboto;
    color: #C2C2C2;
}

QPushButton#toogleButton:checked {
    background-color: #454549;
    border-color: #454549;
}

QPushButton#addButton {
    image: url(:/icons/add-button.svg);
    border: none;
    background-color: transparent; 
    margin: 0;
    padding: 0;
    width: 24px;
    height: 24px;
}

QPushButton#addButton QToolTip {
    background-color: #48484d;
    border-radius: 2px;
    color: #c2c2c2;
    text-align: center;
    font-family: Roboto;
    font-size: 14px;
    width: 125px;
    height: 33px;
}

QPushButton#addButton:hover {
    image: url(:/icons/add-button-hover.svg);
}

QPushButton#addButton:pressed {
    background-color: rgba(128, 128, 128, 0.5);
}

QGraphicsView {
    qproperty-backgroundBrush: #222226;
    border: none;
}

QPushButton#GrayButton {
    background-color: #4C4C51;
    width: 58px;
    height: 26px;
    border-radius: 2px;
    color: #C2C2C2;
    font: normal normal normal 15px Roboto;
    padding-left: 5px;
    padding-right: 5px;
}

QPushButton#GrayButton:checked {
    background-color: #6C6C73;
    color: #E0E0E0;

}

CheckPanel#SettingPanel {
    
    background-color: #323236;
}

CheckPanel#SettingPanel QLabel {
    color: #838384;
    font: normal normal normal 15px Roboto;
}

QFrame#SettingPanel {
    background-color: #323236;
}

QFrame#SettingPanel QLabel {
    color: #838384;
    font: normal normal normal 15px Roboto;
}