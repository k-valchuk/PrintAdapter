QGroupBox#pageSetupGroupBox {
   border: 1px solid #494949;
   border-radius: 2px;
   margin-top: 10px;
   font: normal normal normal 15px Roboto;
}
QGroupBox#pageSetupGroupBox::title {
   color: #BABABA;
    subcontrol-origin: margin;
    subcontrol-position: top left;
    top: 2px;
    left: 10px;
    padding: 0 3px;
}