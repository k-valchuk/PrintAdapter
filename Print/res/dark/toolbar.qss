QToolBar {
    background-color: #323236;
}
QToolBar::separator {
    background-color: #1E1E22;
    width: 1px;
    margin-left: 5px;
    margin-right: 5px;
}

QToolButton {
    background-color: transparent;
}



QToolBar QLabel {
    font: normal normal normal 15px/18px Roboto;
    color: #838384;
    margin-left: 5px;
}

QToolBar QLineEdit {
    background-color: #222226;
    font: normal normal normal 15px/18px Roboto;
    color: #A8A8A8;
    border: none;
    margin-left: 10px;
    margin-right: 5px;
    width: 40px;
}