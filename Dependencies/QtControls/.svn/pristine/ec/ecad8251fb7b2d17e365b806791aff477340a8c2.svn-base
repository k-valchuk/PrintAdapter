<RCC>
    <qresource prefix="/filter">
        <file alias="calendar_filter">images/calendar_filter.svg</file>
        <file alias="text_filter">images/text_filter.svg</file>
        <file alias="star_blue">images/star_blue.svg</file>
        <file alias="star_gray">images/star_gray.svg</file>
        <file alias="filter_icon">images/filter_icon.svg</file>
        <file alias="(">images/(.svg</file>
        <file alias=")">images/).svg</file>
        <file alias="search_icon">images/search_icon.svg</file>
        <file alias="leftArrow">images/leftArrow.svg</file>
        <file alias="history_blue">images/history_blue.svg</file>
        <file alias="history_gray">images/history_gray.svg</file>
        <file alias="presets_blue">images/presets_blue.svg</file>
        <file alias="presets_gray">images/presets_gray.svg</file>
        <file alias="add">images/add.svg</file>
        <file alias="add_hover">images/add_hover.svg</file>
    </qresource>
</RCC>
