#ifndef BRAMPLAYERTYPES_H
#define BRAMPLAYERTYPES_H

namespace BramPlayer
{
    // Размер картинки
    enum class EPleerSize : unsigned
    {
        ePSLowRes,	// LowRes_360x288
        ePSSD,		// PALSD_720x576
        ePSFHD		// HD1080i_1920x1080
    };

    // Состояния плеера
    enum class EPlayerState : unsigned
    {
        ePSPlaying, 
        ePSPaused, 
        ePSStopped
    };
}

#endif // BRAMPLAYERTYPES_H
