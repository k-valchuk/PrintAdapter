QTabWidget::pane {
    border-left: none; 
    border-top: 1px solid #1E1E22;
    border-right: none;
    border-bottom: none;
    background-color: transparent;
    font: normal normal medium 15px/18px Roboto;
    letter-spacing: 0px;
    color: #C2C2C2;
}

QTabBar::tab {
    background-color: transparent;
    font: normal normal medium 15px/18px Roboto;
    color: #BABABA; 
    border: none;
    padding: 8px 16px; 
    margin-right: 4px;
}

QTabBar::tab:selected {
    color: #6F8CB7; 
    border-bottom: 2px solid #6F8CB7;
}