<!DOCTYPE RCC>
<RCC version="1.0">
  <qresource prefix="/icons">
    <file alias="modal-close-icon.svg">icons/modal-close-icon.svg</file>
    <file alias="fit-to-page-button.svg">icons/fit-to-page-button.svg</file>
    <file alias="fit-to-width-button.svg">icons/fit-to-width-button.svg</file>
    <file alias="headers-footers-button.svg">icons/headers-footers-button.svg</file>
    <file alias="landscape-layout-button.svg">icons/landscape-layout-button.svg</file>
    <file alias="page-setup-button.svg">icons/page-setup-button.svg</file>
    <file alias="portrait-layout-button.svg">icons/portrait-layout-button.svg</file>
    <file alias="print-button.svg">icons/print-button.svg</file>
    <file alias="zoom-in-button.svg">icons/zoom-in-button.svg</file>
    <file alias="zoom-out-button.svg">icons/zoom-out-button.svg</file>
    <file alias="arrow-up.png">icons/arrow-up.png</file>
    <file alias="arrow-down.png">icons/arrow-down.png</file>
    <file alias="go-to-first-page-button.svg">icons/go-to-first-page-button.svg</file>
    <file alias="go-to-last-page-button.svg">icons/go-to-last-page-button.svg</file>
    <file alias="next-page-button.svg">icons/next-page-button.svg</file>
    <file alias="previous-page-button.svg">icons/previous-page-button.svg</file>
    <file alias="bramspace_icon.ico">icons/bramspace_icon.ico</file>
    <file alias="add-button.svg">icons/add-button.svg</file>
  </qresource>
  <qresource prefix="/styles">
    <file alias="dialogs.qss">dark/dialogs.qss</file>
    <file alias="tables.qss">dark/tables.qss</file>
    <file alias="combobox.qss">dark/combobox.qss</file>
    <file alias="toolbar.qss">dark/toolbar.qss</file>
    <file alias="scrollarea.qss">dark/scrollarea.qss</file>
    <file alias="scrollbox.qss">dark/scrollbox.qss</file>
    <file alias="tabwidget.qss">dark/tabwidget.qss</file>
  </qresource>
</RCC>
